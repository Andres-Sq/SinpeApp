{
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "responseOverrides": {
    "401": {
      "rewrite": "/assets/scripts/401.html"
    }
  },
  "routes": [
    {
      "route": "/customers",
      "rewrite": "/customers/401.html",
      "statusCode": 401
    },
    {
      "route": "/assets/images",
      "statusCode": 401
    },
    {
      "route": "/assets/*"
    }
  ]
}